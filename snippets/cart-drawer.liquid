{%- comment -%}
  Carrito lateral de Skinland V3 sobre el de Dawn.
  Se conservan los IDs, clases y elementos que usan cart.js y cart-drawer.js
  (cart-drawer, cart-drawer-items, #CartDrawer-Form, .cart-item, quantity-input, cart-remove-button,
  .cart-drawer__footer). Todo se vuelve a pintar con la Section Rendering API.

  Uso:
  {% render 'cart-drawer' %}
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'sl-cart-drawer.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sl-cart-drawer.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  assign umbral = settings.sl_envio_gratis_umbral | times: 100
  assign texto_cambio = settings.sl_cart_cambio_ok
-%}

<cart-drawer
  class="drawer sl-cart{% if cart == empty %} is-empty{% endif %}"
  data-sl-texto-cambio="{{ texto_cambio | escape }}"
  data-sl-product-form="{{ 'product-form.js' | asset_url }}"
>
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ settings.sl_cart_titulo }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="drawer__header">
        <h2 class="drawer__heading">
          {{- settings.sl_cart_titulo }}{% if cart.item_count > 0 %} <span class="sl-cart__cuenta">({{ cart.item_count }})</span>{% endif -%}
        </h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          {%- if cart != empty -%}
            {%- liquid
              assign falta = 0
              if umbral > 0 and cart.total_price < umbral
                assign falta = umbral | minus: cart.total_price
              endif
            -%}
            {%- if umbral > 0 -%}
              {%- liquid
                assign progreso = 100
                if falta > 0
                  assign progreso = cart.total_price | times: 100 | divided_by: umbral
                endif
              -%}
              <div class="sl-cart__envio{% if falta == 0 %} sl-cart__envio--ok{% endif %}">
                {%- assign falta_t = falta | money_without_trailing_zeros -%}
                <p class="sl-cart__envio-texto">
                  {%- if falta == 0 -%}
                    {% render 'sl-icon', name: 'check', size: 16 %}
                    <strong>{{ settings.sl_cart_envio_ok }}</strong>
                  {%- else -%}
                    <strong>{{ settings.sl_cart_envio_falta | replace: '[falta]', falta_t }}</strong>
                  {%- endif -%}
                </p>
                <div class="sl-cart__barra" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progreso }}"><span style="width: {{ progreso }}%"></span></div>
              </div>
            {%- endif -%}
          {%- endif -%}

          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <ul class="sl-cart__lista" role="list">
                {%- for item in cart.items -%}
                  {%- liquid
                    assign linea = item.index | plus: 1
                    assign comps = item.product.metafields.custom.routine_products.value
                    assign nombres = ''
                    for c in comps
                      assign n = c.metafields.custom.nombre_corto.value | default: c.title
                      if nombres == ''
                        assign nombres = n
                      else
                        assign nombres = nombres | append: ' · ' | append: n
                      endif
                    endfor

                    assign ahorro_linea = 0
                    if comps != blank
                      capture bs_raw
                        render 'sl-bundle-sum', product: item.product
                      endcapture
                      assign bs = bs_raw | strip | split: '|'
                      if bs[2] == 'true'
                        assign suma = bs[0] | plus: 0
                        if suma > item.final_price
                          assign ahorro_unidad = suma | minus: item.final_price
                          assign ahorro_linea = ahorro_unidad | times: item.quantity
                        endif
                      endif
                    endif
                  -%}
                  <li
                    id="CartDrawer-Item-{{ linea }}"
                    class="cart-item sl-cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                    data-variant-id="{{ item.variant.id }}"
                    data-sl-ahorro="{{ ahorro_linea }}"
                  >
                    <div class="sl-cart-item__foto cart-item__media">
                      {%- if item.image -%}
                        <img
                          class="cart-item__image"
                          src="{{ item.image | image_url: width: 240 }}"
                          alt="{{ item.image.alt | escape }}"
                          loading="lazy"
                          width="96"
                          height="{{ 96 | divided_by: item.image.aspect_ratio | ceil }}"
                        >
                      {%- endif -%}
                    </div>

                    <div class="sl-cart-item__cuerpo cart-item__details">
                      <a href="{{ item.url }}" class="cart-item__name sl-cart-item__titulo break">
                        {{- item.product.title | escape -}}
                      </a>
                      {%- if item.product.has_only_default_variant == false -%}
                        <p class="sl-cart-item__meta">
                          {%- for option in item.options_with_values -%}
                            {{ option.value }}{% unless forloop.last %}, {% endunless %}
                          {%- endfor -%}
                        </p>
                      {%- endif -%}
                      {%- if nombres != blank -%}
                        <p class="sl-cart-item__incluye"><span>{{ settings.sl_cart_incluye }}</span> {{ nombres }}</p>
                      {%- endif -%}
                      {%- for discount in item.line_level_discount_allocations -%}
                        <p class="sl-cart-item__descuento">{{ discount.discount_application.title }}</p>
                      {%- endfor -%}
                      {%- if ahorro_linea > 0 -%}
                        {%- assign ahorro_t = ahorro_linea | money_without_trailing_zeros -%}
                        <p class="sl-cart-item__ahorro">{{ settings.sl_cart_ahorras | replace: '[ahorro]', ahorro_t }}</p>
                      {%- endif -%}

                      <div class="sl-cart-item__acciones">
                        <quantity-input class="quantity cart-quantity">
                          <button
                            class="quantity__button"
                            name="minus"
                            type="button"
                            {% if item.instructions and item.instructions.can_update_quantity == false %}
                              disabled
                            {% endif %}
                          >
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-minus.svg' | inline_asset_content -}}
                            </span>
                          </button>
                          <input
                            class="quantity__input"
                            type="number"
                            data-quantity-variant-id="{{ item.variant.id }}"
                            data-quantity-line-key="{{ item.key }}"
                            name="updates[]"
                            value="{{ item.quantity }}"
                            {% # theme-check-disable %}
                            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                            min="0"
                            data-min="{{ item.variant.quantity_rule.min }}"
                            {% if item.variant.quantity_rule.max != null %}
                              max="{{ item.variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{ item.variant.quantity_rule.increment }}"
                            {% # theme-check-enable %}
                            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                            id="Drawer-quantity-{{ linea }}"
                            data-index="{{ linea }}"
                            {% if item.instructions and item.instructions.can_update_quantity == false %}
                              disabled
                            {% endif %}
                          >
                          <button
                            class="quantity__button"
                            name="plus"
                            type="button"
                            {% if item.instructions and item.instructions.can_update_quantity == false %}
                              disabled
                            {% endif %}
                          >
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-plus.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </quantity-input>

                        <cart-remove-button id="CartDrawer-Remove-{{ linea }}" data-index="{{ linea }}">
                          <button
                            type="button"
                            class="sl-cart-item__quitar"
                            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            data-variant-id="{{ item.variant.id }}"
                            {% if item.instructions and item.instructions.can_remove == false %}
                              hidden
                            {% endif %}
                          >
                            {{- settings.sl_cart_quitar -}}
                          </button>
                        </cart-remove-button>
                      </div>

                      <div
                        id="CartDrawer-LineItemError-{{ linea }}"
                        class="cart-item__error"
                        role="alert"
                      >
                        <small class="cart-item__error-text"></small>
                      </div>
                    </div>

                    <div class="sl-cart-item__precio cart-item__totals">
                      {%- render 'loading-spinner' -%}
                      {%- if item.original_line_price != item.final_line_price -%}
                        <s class="sl-cart-item__tachado">{{ item.original_line_price | money_without_trailing_zeros }}</s>
                        <strong>{{ item.final_line_price | money_without_trailing_zeros }}</strong>
                      {%- else -%}
                        <strong>{{ item.original_line_price | money_without_trailing_zeros }}</strong>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>

      <div class="drawer__footer">
        <div class="cart-drawer__footer">
        {%- if cart != empty -%}
          {%- liquid
            assign ahorro_total = 0
            for item in cart.items
              assign comps_f = item.product.metafields.custom.routine_products.value
              if comps_f != blank
                capture bs_raw_f
                  render 'sl-bundle-sum', product: item.product
                endcapture
                assign bsf = bs_raw_f | strip | split: '|'
                if bsf[2] == 'true'
                  assign suma_f = bsf[0] | plus: 0
                  if suma_f > item.final_price
                    assign ahorro_total = suma_f | minus: item.final_price | times: item.quantity | plus: ahorro_total
                  endif
                endif
              endif
            endfor

            # Tarjeta de envío gratis: el complemento de los ajustes, si no está ya en el carrito
            # (ni como producto ni dentro de una rutina) y alcanza para llegar al umbral.
            assign comp = settings.sl_complemento_envio
            assign mostrar_comp = false
            if umbral > 0 and cart.total_price < umbral and comp != blank and comp.available
              assign comp_var = comp.selected_or_first_available_variant
              assign falta_f = umbral | minus: cart.total_price
              if comp_var.price >= falta_f
                assign mostrar_comp = true
                for item in cart.items
                  if item.product.id == comp.id
                    assign mostrar_comp = false
                  endif
                  for c in item.product.metafields.custom.routine_products.value
                    if c.id == comp.id
                      assign mostrar_comp = false
                    endif
                  endfor
                endfor
              endif
            endif

            # Subir al kit: primera línea cuyo producto tiene custom.upgrade disponible y que aún no está en el carrito.
            assign up = null
            for item in cart.items
              if up == null
                assign cand = item.product.metafields.custom.upgrade.value
                if cand != blank and cand.available
                  assign ya = false
                  for otro in cart.items
                    if otro.product.id == cand.id
                      assign ya = true
                    endif
                  endfor
                  unless ya
                    assign cand_var = cand.selected_or_first_available_variant
                    if cand_var.price > item.variant.price
                      assign up = cand
                      assign up_linea = item
                    endif
                  endunless
                endif
              endif
            endfor
          -%}

          {%- if mostrar_comp -%}
            {%- assign comp_precio_t = comp_var.price | money_without_trailing_zeros -%}
            <div class="sl-cart__complemento">
              {%- if comp.featured_image -%}
                <img class="sl-cart__complemento-foto" src="{{ comp.featured_image | image_url: width: 120 }}" alt="" width="52" height="52" loading="lazy">
              {%- endif -%}
              <p class="sl-cart__complemento-texto">{{ settings.sl_cart_comp | replace: '[producto]', comp.title | replace: '[precio]', comp_precio_t }}</p>
              <product-form class="sl-cart__form" data-hide-errors="true">
                {%- form 'product', comp, id: 'sl-cart-comp-form', class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" value="{{ comp_var.id }}" class="product-variant-id">
                  <button type="submit" name="add" class="sl-btn sl-btn--sm">
                    <span>{{ settings.sl_cart_agregar }}</span>
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            </div>
          {%- endif -%}

          {%- if up != null -%}
            {%- assign up_var = up.selected_or_first_available_variant -%}
            {%- assign dif = up_var.price | minus: up_linea.variant.price -%}
            {%- assign dif_t = dif | money_without_trailing_zeros -%}
            <div class="sl-cart__upgrade" data-sl-reemplaza="{{ up_linea.variant.id }}">
              {%- if up_linea.product.metafields.custom.upgrade_texto.value != blank -%}
                <p class="sl-cart__upgrade-pregunta">{{ up_linea.product.metafields.custom.upgrade_texto.value }}</p>
              {%- endif -%}
              <product-form class="sl-cart__form" data-hide-errors="true">
                {%- form 'product', up, id: 'sl-cart-up-form', class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" value="{{ up_var.id }}" class="product-variant-id">
                  <button type="submit" name="add" class="sl-cart__upgrade-boton" data-sl-upgrade>
                    <span>{{ settings.sl_cart_upgrade | replace: '[titulo]', up.title | replace: '[diferencia]', dif_t }}</span>
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            </div>
          {%- endif -%}
        {%- endif -%}

          <p class="sl-cart__aviso" data-sl-aviso role="status" hidden></p>

          {%- if cart != empty -%}
            <dl class="sl-cart__resumen">
              <div class="sl-cart__fila">
                <dt>{{ settings.sl_cart_subtotal }}</dt>
                <dd>{{ cart.items_subtotal_price | money_without_trailing_zeros }}</dd>
              </div>
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                {%- for discount in cart.cart_level_discount_applications -%}
                  <div class="sl-cart__fila sl-cart__fila--descuento">
                    <dt>{{ discount.title | escape }}</dt>
                    <dd>−{{ discount.total_allocated_amount | money_without_trailing_zeros }}</dd>
                  </div>
                {%- endfor -%}
              {%- endif -%}
              {%- if ahorro_total > 0 -%}
                <div class="sl-cart__fila sl-cart__fila--ahorro">
                  <dt>{{ settings.sl_cart_ahorro_rutina }}</dt>
                  <dd>{{ ahorro_total | money_without_trailing_zeros }}</dd>
                </div>
              {%- endif -%}
              <div class="sl-cart__fila">
                <dt>{{ settings.sl_cart_envio_linea }}</dt>
                <dd>{{ settings.sl_cart_envio_calc }}</dd>
              </div>
            </dl>
          {%- endif -%}

        <div class="cart__ctas" {{ block.shopify_attributes }}>
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button sl-btn sl-btn--tinta sl-btn--block"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            {{ settings.sl_cart_pagar }} · {{ cart.total_price | money_without_trailing_zeros }}
          </button>
        </div>

        {%- if settings.sl_cart_pie != blank -%}
          <p class="sl-cart__pie">{{ settings.sl_cart_pie }}</p>
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
