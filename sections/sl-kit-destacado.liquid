{{ 'sl-kit-destacado.css' | asset_url | stylesheet_tag }}
{{ 'sl-acordeon.css' | asset_url | stylesheet_tag }}

{%- assign p = section.settings.kit -%}

{%- if p != blank -%}
  <section class="sl-kit-destacado sl-scope" aria-labelledby="sl-kit-destacado-{{ section.id }}">
    <div class="sl-container">
      <div class="sl-kit-destacado__cab">
        {%- if section.settings.eyebrow != blank -%}
          <span class="sl-kit-destacado__chip">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="sl-h1 sl-kit-destacado__titulo" id="sl-kit-destacado-{{ section.id }}">{{ section.settings.titulo }}</h2>
      </div>
      <div class="sl-kit-destacado__lista">
        {% render 'sl-acordeon-producto',
          product: p,
          grupo: section.id,
          abierto: true,
          nombre_tipo: false,
          texto_productos: section.settings.texto_productos,
          texto_por_separado: section.settings.texto_por_separado,
          texto_ahorras: section.settings.texto_ahorras,
          boton: section.settings.boton,
          texto_agotado: section.settings.texto_agotado,
          texto_avisame: section.settings.texto_avisame,
          url_aviso: section.settings.url_aviso,
          texto_desde: section.settings.texto_desde
        %}
        {%- if section.settings.coleccion != blank -%}
          {%- for o in section.settings.coleccion.products -%}
            {%- if o.id != p.id -%}
              {% render 'sl-acordeon-producto',
                product: o,
                grupo: section.id,
                abierto: false,
                nombre_tipo: false,
                texto_productos: section.settings.texto_productos,
                texto_por_separado: section.settings.texto_por_separado,
                texto_ahorras: section.settings.texto_ahorras,
                boton: section.settings.boton,
                texto_agotado: section.settings.texto_agotado,
                texto_avisame: section.settings.texto_avisame,
                url_aviso: section.settings.url_aviso,
                texto_desde: section.settings.texto_desde
              %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
  <script src="{{ 'sl-acordeon.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Skinland · Kits",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "kit", "label": "Kit abierto al cargar", "info": "Sin producto, la sección no se muestra." },
    { "type": "collection", "id": "coleccion", "label": "Colección de kits", "info": "De aquí salen los otros kits, cerrados." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Kits por objetivo" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Todo en una caja" },
    { "type": "url", "id": "url_aviso", "label": "Enlace de aviso de stock", "info": "Formulario o Klaviyo back-in-stock. Si está vacío, los kits agotados solo dicen Agotado." },
    { "type": "text", "id": "texto_productos", "label": "Etiqueta de productos", "default": "[n] productos", "info": "Usa [n]." },
    { "type": "text", "id": "texto_por_separado", "label": "Texto del tachado", "default": "Por separado" },
    { "type": "text", "id": "texto_ahorras", "label": "Etiqueta de ahorro", "default": "Ahorras [ahorro]", "info": "Usa [ahorro]." },
    { "type": "text", "id": "texto_desde", "label": "Texto de la fila", "default": "[precio]", "info": "Usa [precio]." },
    { "type": "text", "id": "boton", "label": "Botón", "default": "Ver [titulo] →", "info": "Usa [titulo]." },
    { "type": "text", "id": "texto_agotado", "label": "Texto de agotado", "default": "Agotado" },
    { "type": "text", "id": "texto_avisame", "label": "Texto de aviso", "default": "Avísame" }
  ],
  "presets": [{ "name": "Skinland · Kits" }]
}
{% endschema %}
