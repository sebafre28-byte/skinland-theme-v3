{{ 'sl-rutinas.css' | asset_url | stylesheet_tag }}
{{ 'sl-acordeon.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bloques_ok = 0
  assign inicial_n = 0
  for block in section.blocks
    if block.settings.destacada != blank
      assign bloques_ok = bloques_ok | plus: 1
      if block.settings.marcada and inicial_n == 0
        assign inicial_n = bloques_ok
      endif
    endif
  endfor
  if inicial_n == 0
    assign inicial_n = 1
  endif
-%}

{%- if bloques_ok > 0 -%}
  <section class="sl-rutinas sl-scope" id="rutinas" aria-labelledby="sl-rutinas-{{ section.id }}" data-sl-rutinas>
    <div class="sl-container">
      <h2 class="sl-h2" id="sl-rutinas-{{ section.id }}">{{ section.settings.titulo }}</h2>

      {%- if bloques_ok > 1 -%}
        <div class="sl-rutinas__tabs" role="group" aria-label="{{ section.settings.titulo | escape }}">
          {%- assign n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.destacada != blank -%}
              {%- assign n = n | plus: 1 -%}
              <button type="button" class="sl-rutinas__tab" data-sl-tab="{{ block.id }}" aria-pressed="{% if n == inicial_n %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.etiqueta }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.destacada -%}
        {%- if p != blank -%}
          {%- assign n = n | plus: 1 -%}
          {%- assign pasos = p.metafields.custom.routine_products.value.size | plus: 0 -%}
          <div class="sl-rutinas__panel" data-sl-panel="{{ block.id }}" {% unless n == inicial_n %}hidden{% endunless %}>
            {% render 'sl-acordeon-producto',
              product: p,
              grupo: block.id,
              abierto: true,
              nombre_tipo: true,
              texto_productos: block.settings.texto_productos,
              texto_por_separado: block.settings.texto_por_separado,
              texto_ahorras: block.settings.texto_ahorras,
              boton: block.settings.boton,
              texto_agotado: block.settings.texto_agotado,
              texto_desde: block.settings.texto_desde
            %}
            {%- if block.settings.coleccion != blank -%}
              {%- for o in block.settings.coleccion.products -%}
                {%- assign o_pasos = o.metafields.custom.routine_products.value.size | plus: 0 -%}
                {%- if o.id != p.id and o_pasos == pasos -%}
                  {% render 'sl-acordeon-producto',
                    product: o,
                    grupo: block.id,
                    abierto: false,
                    nombre_tipo: true,
                    texto_productos: block.settings.texto_productos,
                    texto_por_separado: block.settings.texto_por_separado,
              texto_ahorras: block.settings.texto_ahorras,
                    boton: block.settings.boton,
                    texto_agotado: block.settings.texto_agotado,
                    texto_desde: block.settings.texto_desde
                  %}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  <script src="{{ 'sl-rutinas.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'sl-acordeon.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Skinland · Rutinas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Tu rutina según tu piel" }
  ],
  "blocks": [
    {
      "type": "version",
      "name": "Versión de rutina",
      "settings": [
        { "type": "text", "id": "etiqueta", "label": "Texto del selector", "default": "Express · 3 pasos" },
        { "type": "checkbox", "id": "marcada", "label": "Marcada al cargar la página", "default": false, "info": "Esta versión se ve seleccionada al entrar. Si ninguna está marcada, se usa la primera." },
        { "type": "product", "id": "destacada", "label": "Rutina destacada", "info": "Sin producto, la versión no se muestra." },
        { "type": "collection", "id": "coleccion", "label": "Colección de rutinas", "info": "De aquí salen las otras rutinas con la misma cantidad de pasos que la destacada (calculada desde sus productos)." },
        { "type": "text", "id": "texto_productos", "label": "Etiqueta de pasos", "default": "[n] productos", "info": "Usa [n]." },
        { "type": "text", "id": "texto_por_separado", "label": "Texto del tachado", "default": "Si compras los productos por separado pagarías" },
        { "type": "text", "id": "texto_ahorras", "label": "Etiqueta de ahorro", "default": "Ahorras [ahorro]", "info": "Usa [ahorro]; el monto se calcula y lleva signo menos." },
        { "type": "text", "id": "boton", "label": "Botón", "default": "Ver [titulo] →", "info": "Usa [titulo]." },
        { "type": "text", "id": "texto_desde", "label": "Texto de las otras rutinas", "default": "desde [precio]", "info": "Usa [precio]." },
        { "type": "text", "id": "texto_agotado", "label": "Texto de agotado", "default": "Agotado" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Skinland · Rutinas" }]
}
{% endschema %}
