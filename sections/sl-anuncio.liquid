{{ 'sl-anuncio.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="sl-anuncio" data-sl-anuncio role="region" aria-label="{{ section.settings.etiqueta_aria }}">
    <div class="sl-anuncio__track">
      <ul class="sl-anuncio__lista">
        {%- for block in section.blocks -%}
          {%- liquid
            assign texto = block.settings.texto
            if block.type == 'envio_gratis'
              assign umbral = settings.sl_envio_gratis_umbral | times: 100 | money_without_trailing_zeros
              assign texto = block.settings.texto | append: ' ' | append: umbral
            endif
          -%}
          {%- if texto != blank -%}
            <li class="sl-anuncio__item" {{ block.shopify_attributes }}>
              {%- if block.settings.enlace != blank -%}
                <a href="{{ block.settings.enlace }}">{{ texto | strip }}</a>
              {%- else -%}
                {{ texto | strip }}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <script src="{{ 'sl-anuncio.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Skinland · Anuncio",
  "tag": "section",
  "class": "sl-anuncio-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "etiqueta_aria",
      "label": "Etiqueta accesible",
      "default": "Anuncios"
    }
  ],
  "blocks": [
    {
      "type": "texto",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "texto",
          "label": "Texto"
        },
        {
          "type": "url",
          "id": "enlace",
          "label": "Enlace"
        }
      ]
    },
    {
      "type": "envio_gratis",
      "name": "Envío gratis",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "texto",
          "label": "Texto antes del monto",
          "info": "El monto sale del ajuste \"Envío gratis desde\" del tema.",
          "default": "Envío gratis sobre"
        },
        {
          "type": "url",
          "id": "enlace",
          "label": "Enlace"
        }
      ]
    }
  ]
}
{% endschema %}
