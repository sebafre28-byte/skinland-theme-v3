{{ 'sl-cta-final.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign mf = product.metafields.custom
  assign variante = product.selected_or_first_available_variant
  assign precio = variante.price
  assign disponible = variante.available
  assign form_id = 'sl-form-' | append: product.id

  capture bs_raw
    render 'sl-bundle-sum', product: product
  endcapture
  assign bs = bs_raw | strip | split: '|'
  assign bs_ahorro = bs[1] | plus: 0

  capture color_necesidad
    render 'sl-color-necesidad', product: product
  endcapture
  assign color_necesidad = color_necesidad | strip

  assign tipo_piel = mf.tipo_piel.value | first | downcase
  assign titulo = section.settings.titulo
  if titulo contains '[tipo de piel]'
    if tipo_piel != blank
      assign titulo = titulo | replace: '[tipo de piel]', tipo_piel
    else
      assign titulo = section.settings.titulo_alterno
    endif
  endif
  assign titulo = titulo | replace: '[producto]', product.title

  assign suelto = false
  if mf.routine_products.value == blank and mf.routine_cta_text.value == blank
    assign suelto = true
    assign titulo = section.settings.titulo_individual | replace: '[producto]', product.title
  endif

  # Producto suelto: la rutina más corta que lo incluye, para el enlace bajo el botón
  assign rutina_enlace = nil
  assign hay_enlace = false
  if suelto and section.settings.coleccion_rutinas != blank
    for pasos in (3..6)
      for r in section.settings.coleccion_rutinas.products
        if rutina_enlace == nil and r.metafields.custom.routine_products.value.size == pasos
          for c in r.metafields.custom.routine_products.value
            if c.id == product.id
              assign rutina_enlace = r
              assign hay_enlace = true
            endif
          endfor
        endif
      endfor
    endfor
  endif

  assign cta = mf.routine_cta_text.value | default: section.settings.cta_texto_defecto
  if mf.routine_products.value == blank and mf.routine_cta_text.value == blank
    assign cta = settings.sl_cta_individual
  endif
-%}

<section class="sl-cta sl-scope" data-sl-color="{{ color_necesidad }}" aria-labelledby="sl-cta-{{ section.id }}">
  <div class="sl-cta__tarjeta">
    <div class="sl-cta__texto">
      <h2 class="sl-cta__titulo" id="sl-cta-{{ section.id }}">{{ titulo }}</h2>
      <div class="sl-cta__precio">
        <span class="sl-cta__monto">{{ precio | money_without_trailing_zeros }}</span>
        {%- if bs_ahorro > 0 and suelto == false -%}
          {%- assign ahorro_monto = bs_ahorro | money_without_trailing_zeros -%}
          {%- assign ahorro_menos = '−' | append: ahorro_monto -%}
          <span class="sl-sticker">{{ section.settings.texto_ahorras | default: '[ahorro]' | replace: '[ahorro]', ahorro_menos }}</span>
        {%- endif -%}
      </div>
    </div>
    <div class="sl-cta__accion">
    <button
      type="submit"
      form="{{ form_id }}"
      class="sl-btn sl-btn--compra sl-cta__boton"
      data-sl-externo
      {% unless disponible %}disabled{% endunless %}
    >
      <span>{% if disponible %}{{ cta }}{% else %}{{ section.settings.agotado_texto }}{% endif %}</span>
      {%- render 'loading-spinner' -%}
    </button>
    {%- if hay_enlace -%}
      <a class="sl-cta__rutina" href="{{ rutina_enlace.url }}">{{ section.settings.texto_ver_rutina | replace: '[titulo]', rutina_enlace.title }}</a>
    {%- endif -%}
    </div>
  </div>
</section>
<script src="{{ 'sl-form-externo.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Skinland · Cierre",
  "tag": "div",
  "class": "sl-cta-final-section",
  "settings": [
    {
      "type": "text",
      "id": "texto_ahorras",
      "label": "Etiqueta de ahorro",
      "info": "Usa [ahorro]; el monto se calcula y lleva signo menos.",
      "default": "Ahorras [ahorro]"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "info": "Usa [tipo de piel] y [producto].",
      "default": "Tu rutina para [tipo de piel], lista para empezar."
    },
    {
      "type": "text",
      "id": "titulo_alterno",
      "label": "Título si el producto no tiene tipo de piel",
      "info": "Usa [producto].",
      "default": "Tu [producto], lista para empezar."
    },
    {
      "type": "text",
      "id": "titulo_individual",
      "label": "Título de un producto suelto",
      "info": "Se usa en productos que no son rutina ni kit. Usa [producto].",
      "default": "[producto], listo para sumar a tu rutina."
    },
    {
      "type": "collection",
      "id": "coleccion_rutinas",
      "label": "Colección de rutinas",
      "info": "En un producto suelto, de aquí sale la rutina más corta que lo incluye para el enlace bajo el botón. Sin colección o sin rutina, no se muestra el enlace."
    },
    {
      "type": "text",
      "id": "texto_ver_rutina",
      "label": "Enlace a la rutina completa",
      "info": "Usa [titulo].",
      "default": "Ver la rutina completa: [titulo] →"
    },
    {
      "type": "text",
      "id": "cta_texto_defecto",
      "label": "Texto del botón",
      "info": "Se usa si el producto no tiene routine_cta_text.",
      "default": "Comenzar mi rutina"
    },
    {
      "type": "text",
      "id": "agotado_texto",
      "label": "Texto de agotado",
      "default": "Agotado"
    }
  ]
}
{% endschema %}
