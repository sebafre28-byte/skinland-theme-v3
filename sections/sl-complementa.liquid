{{ 'sl-complementa.css' | asset_url | stylesheet_tag }}
{{ 'sl-tarjeta.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign complementos = product.metafields.custom.complementos_recomendados.value
  assign mostradas = 0
-%}

{%- capture tarjetas -%}
  {%- for c in complementos -%}
    {%- if c.id != product.id and c.available and mostradas < section.settings.maximo -%}
      {%- assign mostradas = mostradas | plus: 1 -%}
      {%- assign form_id = 'sl-complementa-' | append: section.id | append: '-' | append: c.id -%}
      <li>
        {% render 'sl-tarjeta-producto',
          product: c,
          form_id: form_id,
          texto_agregar: section.settings.texto_agregar,
          texto_agotado: section.settings.texto_agotado,
          texto_ver: section.settings.texto_ver,
          mostrar_marca: true
        %}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if mostradas > 0 -%}
  <section class="sl-complementa sl-scope" aria-labelledby="sl-complementa-{{ section.id }}">
    <div class="sl-container">
      <div class="sl-complementa__intro">
        {%- if section.settings.eyebrow != blank -%}<span class="sl-complementa__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="sl-h2" id="sl-complementa-{{ section.id }}">{{ section.settings.titulo }}</h2>
        {%- if section.settings.bajada != blank -%}<p class="sl-complementa__bajada">{{ section.settings.bajada }}</p>{%- endif -%}
      </div>
      <ul class="sl-complementa__grid sl-complementa__grid--n{{ mostradas }}" role="list">{{ tarjetas }}</ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="sl-complementa__aviso sl-scope">{{ section.settings.aviso_editor }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Skinland · Complementa",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "maximo", "label": "Máximo de productos", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Para sacarle más partido" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Completa tu rutina" },
    { "type": "text", "id": "bajada", "label": "Bajada", "info": "Opcional.", "default": "Productos que se llevan bien con este paso." },
    { "type": "text", "id": "texto_agregar", "label": "Botón agregar", "default": "Agregar" },
    { "type": "text", "id": "texto_ver", "label": "Botón si tiene varias versiones", "default": "Ver opciones" },
    { "type": "text", "id": "texto_agotado", "label": "Texto de agotado", "default": "Agotado" },
    { "type": "text", "id": "aviso_editor", "label": "Aviso en el editor", "info": "Solo se ve en el editor de temas, cuando el producto no tiene complementos.", "default": "Esta sección se oculta: el producto no tiene complementos recomendados disponibles." }
  ],
  "presets": [{ "name": "Skinland · Complementa" }]
}
{% endschema %}
