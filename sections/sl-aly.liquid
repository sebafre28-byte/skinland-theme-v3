{{ 'sl-aly.css' | asset_url | stylesheet_tag }}

{%- liquid
  capture wa_raw
    render 'sl-whatsapp-url'
  endcapture
  assign wa = wa_raw | strip
  assign test = settings.sl_test_url
-%}

{%- if test != blank or wa != blank -%}
  <section class="sl-aly sl-scope" aria-labelledby="sl-aly-{{ section.id }}">
    <div class="sl-container">
      <div class="sl-aly__caja">
        <div class="sl-aly__cab">
          {%- if section.settings.foto != blank -%}
            {{ section.settings.foto | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '72px', class: 'sl-aly__foto', alt: section.settings.nombre }}
          {%- else -%}
            {%- render 'sl-aly-avatar' -%}
          {%- endif -%}
          <div>
            <h2 class="sl-aly__titulo" id="sl-aly-{{ section.id }}">{{ section.settings.titulo }}</h2>
            {%- if section.settings.bajada != blank -%}
              <p class="sl-aly__bajada">{{ section.settings.bajada }}</p>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.pregunta != blank -%}
          <div class="sl-aly__chat">
            <p class="sl-aly__escribe" aria-hidden="true"><i></i><i></i><i></i></p>
            <p class="sl-aly__pregunta">{{ section.settings.pregunta }}</p>
          </div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="sl-aly__respuestas" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign destino = ''
                if block.settings.mensaje != blank and wa != blank
                  capture destino_raw
                    render 'sl-whatsapp-url', mensaje: block.settings.mensaje
                  endcapture
                  assign destino = destino_raw | strip
                endif
              -%}
              {%- if block.settings.texto != blank and destino != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a class="sl-aly__resp" data-sl-color="{{ block.settings.color }}" href="{{ destino }}" target="_blank" rel="noopener">{{ block.settings.texto }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if wa != blank -%}
          <a class="sl-btn sl-btn--tinta sl-btn--block" href="{{ wa }}" target="_blank" rel="noopener">{{ section.settings.boton_aly }}</a>
        {%- endif -%}
        {%- if test != blank -%}
          <a class="sl-btn sl-btn--block" href="{{ test }}">{{ section.settings.boton }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  {{ 'sl-aly.css' | asset_url | stylesheet_tag }}
  <p class="sl-aly__aviso sl-scope">{{ section.settings.aviso_editor }}</p>
{%- endif -%}

{% schema %}
{
  "name": "Skinland · Aly",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "foto",
      "label": "Foto de quien asesora",
      "info": "Solo una foto real y con permiso de la persona. Si está vacía se muestra el avatar animado de Aly."
    },
    { "type": "text", "id": "nombre", "label": "Nombre del asistente", "default": "Aly" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "¿No sabes qué elegir?" },
    { "type": "text", "id": "bajada", "label": "Bajada", "default": "Haz el test o escríbele a Aly por WhatsApp" },
    { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Cómo sientes tu piel a mediodía?" },
    { "type": "text", "id": "boton_aly", "label": "Botón de WhatsApp", "default": "Hablar con Aly por WhatsApp", "info": "Usa el enlace de WhatsApp o, si no hay, el teléfono de la tienda." },
    { "type": "text", "id": "boton", "label": "Botón del test", "default": "Hacer el test completo", "info": "Solo se muestra si hay enlace del test en los ajustes del tema." },
    { "type": "text", "id": "aviso_editor", "label": "Aviso en el editor", "info": "Solo se ve dentro del editor del tema, no en la tienda.", "default": "Aly oculta: agrega el enlace del test, un enlace de WhatsApp o el teléfono de la tienda." }
  ],
  "blocks": [
    {
      "type": "respuesta",
      "name": "Respuesta rápida",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto", "default": "Brillante" },
        { "type": "textarea", "id": "mensaje", "label": "Mensaje de WhatsApp", "info": "Mensaje que se abre en WhatsApp al tocar la respuesta. Sin mensaje, la respuesta no se muestra." },
        { "type": "select", "id": "color", "label": "Color", "default": "menta", "options": [
          { "value": "menta", "label": "Menta" }, { "value": "lima", "label": "Lima" }, { "value": "amarillo", "label": "Amarillo" },
          { "value": "durazno", "label": "Durazno" }, { "value": "celeste", "label": "Celeste" }, { "value": "lila", "label": "Lila" }, { "value": "rosa", "label": "Rosa" }
        ] }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Skinland · Aly" }]
}
{% endschema %}
