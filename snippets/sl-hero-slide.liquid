{%- comment -%}
  Una lámina de la escena animada del hero: dibujo genérico de los pasos de una rutina o kit y, abajo, cápsulas (tipos de piel u objetivos).
  Parámetros: etiqueta, pasos (3, 4 o 5), capsulas (una por línea), indice, activa (true solo en la primera).
  No usa productos reales: son dibujos del tipo de paso. Los nombres de los pasos salen de los ajustes del tema.
{%- endcomment -%}
{%- liquid
  case pasos
    when '3'
      assign secuencia = 'limpieza,crema,spf'
    when '4'
      assign secuencia = 'limpieza,serum,crema,spf'
    else
      assign secuencia = 'limpieza,serum,crema,spf,local'
  endcase
  assign tipos = secuencia | split: ','
  assign lineas = capsulas | newline_to_br | split: '<br />'
-%}
<div class="sl-escena__lamina"{% unless activa %} aria-hidden="true"{% endunless %}>
  {%- if etiqueta != blank -%}
    <span class="sl-escena__etiqueta">{{ etiqueta }}</span>
  {%- endif -%}
  <div class="sl-escena__panel">
    <ol class="sl-escena__lista sl-escena__lista--n{{ tipos.size }}" role="list">
      {%- for t in tipos -%}
        {%- liquid
          case t
            when 'limpieza'
              assign nombre_paso = settings.sl_paso_n_limpieza
            when 'serum'
              assign nombre_paso = settings.sl_paso_n_serum
            when 'crema'
              assign nombre_paso = settings.sl_paso_n_crema
            when 'spf'
              assign nombre_paso = settings.sl_paso_n_spf
            else
              assign nombre_paso = settings.sl_paso_n_local
          endcase
        -%}
        <li class="sl-escena__prod" data-paso="{{ t }}">
          <span class="sl-escena__num" aria-hidden="true">{{ forloop.index }}</span>
          {% render 'sl-escena-icono', tipo: t %}
          <span class="sl-escena__paso">{{ nombre_paso }}</span>
        </li>
      {%- endfor -%}
    </ol>
    {%- if lineas.size > 0 -%}
      <ul class="sl-escena__capsulas" role="list">
        {%- for l in lineas -%}
          {%- assign l_limpia = l | strip -%}
          {%- if l_limpia != blank -%}<li class="sl-escena__cap">{{ l_limpia }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
