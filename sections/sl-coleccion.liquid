{{ 'sl-coleccion.css' | asset_url | stylesheet_tag }}
{{ 'sl-tarjeta.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="sl-coleccion sl-scope">
    <div class="sl-container">
      <header class="sl-coleccion__cab">
        <h1 class="sl-h1 sl-coleccion__titulo">{{ collection.title | escape }}</h1>
        {%- if section.settings.mostrar_descripcion and collection.description != blank -%}
          <div class="sl-coleccion__descripcion rte">{{ collection.description }}</div>
        {%- endif -%}
      </header>
    </div>

    {%- paginate collection.products by section.settings.productos_por_pagina -%}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

      {%- if section.settings.filtros or section.settings.orden -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper sl-coleccion__filtros{% unless section.settings.filtros %} facets-wrapper--no-filters{% endunless %} page-width"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.filtros,
            enable_sorting: section.settings.orden,
            filter_type: 'horizontal',
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div class="sl-container">
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <p class="sl-coleccion__vacio">
                {{ section.settings.texto_vacio }}
                <a href="{{ collection.url }}" class="sl-coleccion__limpiar">{{ section.settings.texto_limpiar }}</a>
              </p>
            </div>
          {%- else -%}
            <div class="collection">
              <div class="loading-overlay gradient"></div>
              <ul id="product-grid" data-id="{{ section.id }}" class="sl-coleccion__grid" role="list">
                {%- for product in collection.products -%}
                  {%- assign form_id = 'sl-col-' | append: section.id | append: '-' | append: product.id -%}
                  <li>
                    {% render 'sl-tarjeta-producto',
                      product: product,
                      form_id: form_id,
                      texto_agregar: section.settings.texto_agregar,
                      texto_agotado: section.settings.texto_agotado,
                      texto_ver: section.settings.texto_ver,
                      mostrar_marca: true
                    %}
                  </li>
                {%- endfor -%}
              </ul>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "Skinland · Colección",
  "tag": "section",
  "class": "sl-coleccion-section",
  "settings": [
    { "type": "range", "id": "productos_por_pagina", "label": "Productos por página", "min": 8, "max": 36, "step": 4, "default": 16 },
    { "type": "checkbox", "id": "mostrar_descripcion", "label": "Mostrar la descripción de la colección", "default": true },
    { "type": "checkbox", "id": "filtros", "label": "Activar filtros", "default": true, "info": "Los filtros se configuran en Navegación → Filtros de búsqueda y de colección." },
    { "type": "checkbox", "id": "orden", "label": "Activar orden", "default": true },
    { "type": "text", "id": "texto_agregar", "label": "Botón agregar", "default": "Agregar" },
    { "type": "text", "id": "texto_ver", "label": "Botón de productos con variantes", "default": "Ver opciones" },
    { "type": "text", "id": "texto_agotado", "label": "Texto de agotado", "default": "Agotado" },
    { "type": "text", "id": "texto_vacio", "label": "Texto sin productos", "default": "No hay productos con esos filtros." },
    { "type": "text", "id": "texto_limpiar", "label": "Enlace para quitar filtros", "default": "Quitar filtros" }
  ]
}
{% endschema %}
