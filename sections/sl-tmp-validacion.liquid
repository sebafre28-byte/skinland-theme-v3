{%- liquid
  capture rs_raw
    render 'sl-resenas-datos', product: product
  endcapture
  assign rs = rs_raw | strip | split: '|'
  assign rating_n = rs[0] | plus: 0
  assign rating_prom = rs[1] | times: 1.0
-%}
{%- if rating_n >= 1 -%}
  {%- if rating_n == 1 -%}
    {%- assign resenas_texto = section.settings.texto_resena_una | replace: '[n]', rating_n -%}
  {%- else -%}
    {%- assign resenas_texto = section.settings.texto_resenas | replace: '[n]', rating_n -%}
  {%- endif -%}
  <a class="sl-resenas-link" href="#sl-resenas">
    {%- if rating_n >= section.settings.resenas_minimo_promedio -%}
      <span aria-hidden="true" class="sl-resenas-link__estrellas">
        {%- assign llenas = rating_prom | round -%}
        {%- for i in (1..5) -%}{% if i <= llenas %}★{% else %}☆{% endif %}{%- endfor -%}
      </span>
      <strong>{{ rs[1] }}</strong> · {{ resenas_texto }}
    {%- else -%}
      {{ resenas_texto }}
    {%- endif -%}
  </a>
{%- endif -%}
{% schema %}
{
  "name": "Tmp validacion",
  "settings": [
    { "type": "text", "id": "texto_resenas", "label": "Texto", "info": "Usa [n].", "default": "[n] reseñas" },
    { "type": "text", "id": "texto_resena_una", "label": "Texto una", "info": "Usa [n].", "default": "[n] reseña" },
    { "type": "range", "id": "resenas_minimo_promedio", "label": "Mostrar estrellas y promedio desde", "info": "Con menos reseñas se muestra solo la cantidad.", "min": 1, "max": 10, "step": 1, "default": 3 }
  ]
}
{% endschema %}
