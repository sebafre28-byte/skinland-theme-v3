{%- comment -%}
  Dibujos genéricos de un producto por tipo de paso (no son productos reales). Parámetro: tipo (limpieza, serum, crema, spf, local).
  El color de la etiqueta del dibujo viene de --sl-ac, que define el CSS de la escena según el paso.
{%- endcomment -%}
<svg class="sl-escena__dibujo" viewBox="0 0 60 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false">
  {%- case tipo -%}
    {%- when 'limpieza' -%}
      <path d="M17 6h26l-2 54H19z" fill="var(--sl-blanco)"/><rect x="21" y="24" width="18" height="16" rx="3" fill="var(--sl-ac)"/><rect x="20" y="60" width="20" height="13" rx="3" fill="currentColor"/>
    {%- when 'serum' -%}
      <rect x="16" y="30" width="28" height="42" rx="8" fill="var(--sl-blanco)"/><rect x="20" y="46" width="20" height="14" rx="3" fill="var(--sl-ac)"/><rect x="25" y="22" width="10" height="8" fill="currentColor"/><rect x="26" y="6" width="8" height="16" rx="4" fill="currentColor"/>
    {%- when 'crema' -%}
      <rect x="8" y="40" width="44" height="32" rx="9" fill="var(--sl-blanco)"/><rect x="14" y="51" width="32" height="12" rx="3" fill="var(--sl-ac)"/><rect x="6" y="26" width="48" height="15" rx="5" fill="currentColor"/>
    {%- when 'spf' -%}
      <path d="M19 22h22l2 52H17z" fill="var(--sl-blanco)"/><rect x="22" y="7" width="16" height="15" rx="3" fill="currentColor"/><circle cx="30" cy="46" r="9" fill="var(--sl-ac)"/><path d="M30 31v3M30 58v3M21 46h-3M42 46h-3" stroke-width="2"/>
    {%- else -%}
      <rect x="10" y="16" width="40" height="52" rx="7" fill="var(--sl-blanco)"/><circle cx="30" cy="42" r="12" fill="var(--sl-ac)"/><circle cx="30" cy="42" r="3.5" fill="var(--sl-blanco)" stroke-width="2"/>
  {%- endcase -%}
</svg>
