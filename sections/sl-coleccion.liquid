{{ 'sl-coleccion.css' | asset_url | stylesheet_tag }}
{{ 'sl-tarjeta.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="sl-coleccion sl-scope">
    <div class="sl-container">
      <header class="sl-coleccion__cab">
        <h1 class="sl-h1 sl-coleccion__titulo">{{ collection.title | escape }}</h1>
        {%- if section.settings.mostrar_descripcion and collection.description != blank -%}
          <div class="sl-coleccion__descripcion rte">{{ collection.description }}</div>
        {%- endif -%}
      </header>
    </div>

    {%- paginate collection.products by section.settings.productos_por_pagina -%}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

      {%- if section.settings.filtros or section.settings.orden -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper sl-coleccion__filtros{% unless section.settings.filtros %} facets-wrapper--no-filters{% endunless %} page-width"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.filtros,
            enable_sorting: section.settings.orden,
            filter_type: 'horizontal',
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      {%- if section.settings.filtros_tema -%}
        <div
          class="sl-filtros sl-scope"
          data-sl-filtros
          data-t-piel="{{ section.settings.filtros_t_piel | escape }}"
          data-t-necesidad="{{ section.settings.filtros_t_necesidad | escape }}"
          data-t-categoria="{{ section.settings.filtros_t_categoria | escape }}"
          data-t-marca="{{ section.settings.filtros_t_marca | escape }}"
          data-t-conteo="{{ section.settings.filtros_t_conteo | escape }}"
        >
          <details class="sl-filtros__detalle" data-sl-detalle>
            <summary class="sl-filtros__abrir">{{ section.settings.filtros_t_abrir }}</summary>
            <div class="sl-filtros__grupos" data-sl-grupos></div>
          </details>
          <div class="sl-filtros__pie">
            <button type="button" class="sl-filtros__limpiar" data-sl-limpiar hidden>{{ section.settings.filtros_t_limpiar }}</button>
          </div>
          <p class="sl-coleccion__vacio" data-sl-vacio hidden>{{ section.settings.texto_vacio }}</p>
        </div>
        <script src="{{ 'sl-coleccion-filtros.js' | asset_url }}" defer="defer"></script>
        {%- assign pares_cat = section.settings.filtros_mapa_categorias | split: ',' -%}
        {%- assign pares_nec = section.settings.filtros_mapa_necesidades | split: ',' -%}
      {%- endif -%}

      <div class="sl-container">
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <p class="sl-coleccion__vacio">
                {{ section.settings.texto_vacio }}
                <a href="{{ collection.url }}" class="sl-coleccion__limpiar">{{ section.settings.texto_limpiar }}</a>
              </p>
            </div>
          {%- else -%}
            <div class="collection">
              <div class="loading-overlay gradient"></div>
              <ul id="product-grid" data-id="{{ section.id }}" class="sl-coleccion__grid" role="list">
                {%- for product in collection.products -%}
                  {%- assign form_id = 'sl-col-' | append: section.id | append: '-' | append: product.id -%}
                  {%- liquid
                    assign d_piel = '|'
                    assign d_cat = '|'
                    assign d_nec = '|'
                    if section.settings.filtros_tema
                      for tp in product.metafields.custom.tipo_piel.value
                        assign d_piel = d_piel | append: tp | append: '|'
                      endfor
                      for par in pares_cat
                        assign kv = par | split: '='
                        assign k = kv[0] | strip
                        assign v = kv[1] | strip
                        if product.tags contains k and v != blank
                          assign marca_v = '|' | append: v | append: '|'
                          unless d_cat contains marca_v
                            assign d_cat = d_cat | append: v | append: '|'
                          endunless
                        endif
                      endfor
                      for par in pares_nec
                        assign kv = par | split: '='
                        assign k = kv[0] | strip
                        assign v = kv[1] | strip
                        if product.tags contains k and v != blank
                          assign marca_v = '|' | append: v | append: '|'
                          unless d_nec contains marca_v
                            assign d_nec = d_nec | append: v | append: '|'
                          endunless
                        endif
                      endfor
                    endif
                  -%}
                  <li{% if section.settings.filtros_tema %} data-sl-tarjeta data-piel="{{ d_piel | escape }}" data-necesidad="{{ d_nec | escape }}" data-categoria="{{ d_cat | escape }}" data-marca="{{ product.vendor | escape }}"{% endif %}>
                    {% render 'sl-tarjeta-producto',
                      product: product,
                      form_id: form_id,
                      texto_agregar: section.settings.texto_agregar,
                      texto_agotado: section.settings.texto_agotado,
                      texto_ver: section.settings.texto_ver,
                      mostrar_marca: true
                    %}
                  </li>
                {%- endfor -%}
              </ul>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "Skinland · Colección",
  "tag": "section",
  "class": "sl-coleccion-section",
  "settings": [
    { "type": "range", "id": "productos_por_pagina", "label": "Productos por página", "min": 8, "max": 60, "step": 4, "default": 48, "info": "Con los filtros del tema conviene mostrar todos en una página." },
    { "type": "checkbox", "id": "mostrar_descripcion", "label": "Mostrar la descripción de la colección", "default": true },
    { "type": "checkbox", "id": "filtros", "label": "Activar filtros", "default": true, "info": "Los filtros se configuran en Navegación → Filtros de búsqueda y de colección." },
    { "type": "checkbox", "id": "orden", "label": "Activar orden", "default": true },
    { "type": "header", "content": "Filtros del tema (por tipo de piel, necesidad, tipo de producto y marca)" },
    { "type": "checkbox", "id": "filtros_tema", "label": "Mostrar filtros del tema", "default": true, "info": "Funcionan con las etiquetas y metacampos que ya tienen los productos, sin configurar Search & Discovery. Un grupo sin opciones no aparece." },
    { "type": "text", "id": "filtros_t_piel", "label": "Título: tipo de piel", "default": "Tu tipo de piel" },
    { "type": "text", "id": "filtros_t_necesidad", "label": "Título: necesidad", "default": "Qué necesita tu piel" },
    { "type": "text", "id": "filtros_t_categoria", "label": "Título: tipo de producto", "default": "Tipo de producto" },
    { "type": "text", "id": "filtros_t_marca", "label": "Título: marca", "default": "Marca" },
    { "type": "text", "id": "filtros_t_abrir", "label": "Texto para abrir los filtros (celular)", "default": "Filtrar productos" },
    { "type": "text", "id": "filtros_t_conteo", "label": "Texto del contador", "info": "Usa [n].", "default": "[n] productos" },
    { "type": "text", "id": "filtros_t_limpiar", "label": "Botón para limpiar", "default": "Limpiar filtros" },
    { "type": "textarea", "id": "filtros_mapa_categorias", "label": "Etiquetas → tipo de producto", "info": "Formato: etiqueta=Nombre, separado por comas. Etiquetas con el mismo nombre se unen.", "default": "categoria-limpiador=Limpiador, categoria-crema=Crema, categoria-hidratante=Crema, categoria-serum=Sérum, categoria-protector-solar=Protector solar, categoria-spf=Protector solar, categoria-spot-patch=Parche" },
    { "type": "textarea", "id": "filtros_mapa_necesidades", "label": "Etiquetas → necesidad", "info": "Mismo formato. Un producto puede tener varias necesidades.", "default": "objetivo-antiacne=Granitos, objetivo-manchas=Manchas, objetivo-antiedad=Líneas y firmeza, objetivo-firmeza=Líneas y firmeza, objetivo-hidratar=Hidratación, objetivo-calmar=Calmar rojeces, objetivo-irritacion=Calmar rojeces, objetivo-poros=Brillo y poros, objetivo-control-sebo=Brillo y poros, objetivo-luminosidad=Luminosidad, objetivo-reparar-barrera=Cuidar la barrera, objetivo-barrera=Cuidar la barrera, objetivo-textura=Textura, objetivo-proteccion-solar=Protección solar" },
    { "type": "text", "id": "texto_agregar", "label": "Botón agregar", "default": "Agregar" },
    { "type": "text", "id": "texto_ver", "label": "Botón de productos con variantes", "default": "Ver opciones" },
    { "type": "text", "id": "texto_agotado", "label": "Texto de agotado", "default": "Agotado" },
    { "type": "text", "id": "texto_vacio", "label": "Texto sin productos", "default": "No hay productos con esos filtros." },
    { "type": "text", "id": "texto_limpiar", "label": "Enlace para quitar filtros", "default": "Quitar filtros" }
  ]
}
{% endschema %}
